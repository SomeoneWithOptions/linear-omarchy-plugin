#!/bin/bash

# One-time setup for the Linear bar plugin.
#
# Usage:
#   omarchy-linear-setup key                  store the API key in the keyring
#   omarchy-linear-setup check                verify the key and show the account
#   omarchy-linear-setup list [--json]        list teams and their projects
#   omarchy-linear-setup use <team> <project> [--priority 0-4]
#                                             write config.lua for that target
#
# Kept separate from omarchy-linear-issue-create so the hot path the bar calls
# has no setup code in it.

set -euo pipefail

readonly API_URL="https://api.linear.app/graphql"
readonly KEYRING_SERVICE="linear-omarchy"
readonly KEYRING_ACCOUNT="api"

CONFIG=${LINEAR_OMARCHY_CONFIG:-$HOME/.config/omarchy/linear/config.lua}
CACHE_DIR=${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/linear
TOKEN_FILE=${LINEAR_OMARCHY_TOKEN_FILE:-${XDG_DATA_HOME:-$HOME/.local/share}/omarchy/linear/token}
TOKEN=""

die() {
  echo "$1" >&2
  exit 1
}

usage() {
  sed -n '3,10p' "$0" | sed 's/^# \?//'
}

read_token() {
  local token=""

  if command -v secret-tool >/dev/null 2>&1; then
    token=$(secret-tool lookup service "$KEYRING_SERVICE" account "$KEYRING_ACCOUNT" 2>/dev/null || true)
  fi

  if [[ -z $token && -f $TOKEN_FILE ]]; then
    local perms
    perms=$(stat -c '%a' "$TOKEN_FILE")
    [[ $perms == 600 || $perms == 400 ]] ||
      die "Refusing to read $TOKEN_FILE: mode is $perms, expected 600"
    token=$(<"$TOKEN_FILE")
  fi

  token=${token//[$'\n\r']/}
  [[ -n $token ]] || die "No API key stored. Run: $(basename "$0") key"
  printf '%s' "$token"
}

api() {
  printf 'header = "Authorization: %s"\n' "$TOKEN" |
    curl -sS --max-time 20 --config - \
      -X POST "$API_URL" \
      -H "Content-Type: application/json" \
      --data-binary "$1"
}

# $1 = GraphQL document, $2 = optional variables object as JSON.
query() {
  local response err payload vars=${2-}
  [[ -n $vars ]] || vars='{}'
  payload=$(jq -n --arg q "$1" --argjson vars "$vars" '{query: $q, variables: $vars}')
  response=$(api "$payload") || die "Could not reach the Linear API"
  err=$(jq -r '.errors[0].message // empty' <<<"$response")
  [[ -z $err ]] || die "Linear API error: $err"
  printf '%s' "$response"
}

cmd_key() {
  command -v secret-tool >/dev/null 2>&1 ||
    die "secret-tool not installed; write the key to $TOKEN_FILE with mode 600 instead"

  # stdin can be a pipe when this runs from the installer's own bootstrap, so
  # the prompt takes the terminal directly.
  local key=""
  if [[ -r /dev/tty ]]; then
    read -rsp "Linear API key: " key </dev/tty
  else
    read -rsp "Linear API key: " key
  fi
  echo
  [[ -n $key ]] || die "No key entered"

  printf '%s' "$key" |
    secret-tool store --label='Linear API key' service "$KEYRING_SERVICE" account "$KEYRING_ACCOUNT"
  echo "Stored in the login keyring."
}

cmd_check() {
  TOKEN=$(read_token)
  query '{ viewer { name email } }' |
    jq -r '"Authenticated as \(.data.viewer.name) <\(.data.viewer.email)>"'
}

# Page sizes stay modest on purpose: Linear rejects a query by the number of
# nodes it could return, and teams×projects multiplies fast.
cmd_list() {
  local as_json=0
  [[ ${1-} == --json ]] && as_json=1

  TOKEN=$(read_token)
  local response
  response=$(query '{ teams(first: 25) { nodes { name key projects(first: 25) { nodes { name state } } } } }')

  # --json is what the installer picks its menus from, so the shape stays the
  # API's own rather than something parsed back out of the printed table.
  if ((as_json)); then
    jq -c '.data.teams.nodes' <<<"$response"
    return
  fi

  jq -r '.data.teams.nodes[]
      | "\(.name) [\(.key)]",
        (if (.projects.nodes | length) == 0
         then "    (no projects)"
         else (.projects.nodes[] | "    \(.name)  ·  \(.state)")
         end),
        ""' <<<"$response"
}

cmd_use() {
  local team="" project="" priority=""

  while (($# > 0)); do
    case $1 in
    --priority)
      priority=${2-}
      [[ $priority =~ ^[0-4]$ ]] || die "--priority takes 0 none, 1 urgent, 2 high, 3 normal, 4 low"
      shift 2
      ;;
    *)
      if [[ -z $team ]]; then team=$1
      elif [[ -z $project ]]; then project=$1
      else die "Unexpected argument: $1"
      fi
      shift
      ;;
    esac
  done

  [[ -n $team && -n $project ]] ||
    die "Usage: $(basename "$0") use <team> <project> [--priority 0-4]"

  TOKEN=$(read_token)
  local response team_id project_id
  response=$(query 'query ResolveTarget($team: String!, $project: String!) {
    teams(first: 5, filter: { name: { eqIgnoreCase: $team } }) {
      nodes {
        id
        name
        projects(first: 10, filter: { name: { eqIgnoreCase: $project } }) {
          nodes { id name }
        }
      }
    }
  }' "$(jq -n --arg team "$team" --arg project "$project" '{team: $team, project: $project}')")

  team_id=$(jq -r '.data.teams.nodes[0].id // empty' <<<"$response")
  [[ -n $team_id ]] || die "No team named \"$team\". Run: $(basename "$0") list"

  project_id=$(jq -r '.data.teams.nodes[0].projects.nodes[0].id // empty' <<<"$response")
  [[ -n $project_id ]] || die "No project named \"$project\" in team \"$team\". Run: $(basename "$0") list"

  local priority_line="  -- priority = 3,"
  [[ -z $priority ]] || priority_line="  priority = $priority,"

  # Rendered first and compared, so re-running with the same target neither
  # rewrites the file nor leaves another backup behind.
  local rendered
  rendered=$(
    cat <<LUA
-- Linear bar plugin configuration.
-- Names are the source of truth; the plugin caches the matching UUIDs in
-- ${CACHE_DIR#"$HOME"/}/ids.json and re-resolves them whenever a name changes.
return {
  team = "$team",
  project = "$project",

  -- Uncomment to pin the UUIDs and skip name resolution entirely:
  -- team_id = "$team_id",
  -- project_id = "$project_id",

  -- Default priority for new issues: 0 none, 1 urgent, 2 high, 3 normal, 4 low.
$priority_line
}
LUA
  )

  mkdir -p "$(dirname "$CONFIG")"
  if [[ -f $CONFIG && $rendered == "$(<"$CONFIG")" ]]; then
    echo "Config already up to date."
  else
    if [[ -f $CONFIG ]]; then
      cp "$CONFIG" "$CONFIG.bak.$(date +%s)"
      echo "Backed up the existing config."
    fi
    # Written through a temp file: a truncating redirect that is interrupted
    # leaves a config that exists, is non-empty and does not parse, which is
    # exactly the state a rerun should not have to guess about.
    printf '%s\n' "$rendered" >"$CONFIG.tmp"
    mv "$CONFIG.tmp" "$CONFIG"
  fi

  mkdir -p "$CACHE_DIR"
  jq -n --arg team "$team" --arg project "$project" \
    --arg team_id "$team_id" --arg project_id "$project_id" \
    '{team: $team, project: $project, team_id: $team_id, project_id: $project_id}' \
    >"$CACHE_DIR/ids.json.tmp"
  chmod 600 "$CACHE_DIR/ids.json.tmp"
  mv "$CACHE_DIR/ids.json.tmp" "$CACHE_DIR/ids.json"

  echo "Target: $team › $project"
}

case ${1-} in
key) cmd_key ;;
check) cmd_check ;;
list)
  shift
  cmd_list "$@"
  ;;
use)
  shift
  cmd_use "$@"
  ;;
-h | --help | "") usage ;;
*) die "Unknown command: $1" ;;
esac
